parameters:
    level: 5
    phpVersion:
        min: 70200
        max: 80400
    excludePaths:
        - */Tests/*
        - */vendor/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Deliberate BC shim: TreeBuilder::root() exists only in Symfony < 5 and is reached only when
        # getRootNode() is missing (Symfony < 4.2). Analysed against Symfony 5.4 it is reported as unknown
        # (and method_exists() as always true).
        -
            message: '#^Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\TreeBuilder\:\:root\(\)\.$#'
            identifier: method.notFound
            count: 1
            path: DependencyInjection/Configuration.php
        -
            message: '#^Call to function method_exists\(\) with Symfony\\Component\\Config\\Definition\\Builder\\TreeBuilder and ''getRootNode'' will always evaluate to true\.$#'
            identifier: function.alreadyNarrowedType
            count: 1
            path: DependencyInjection/Configuration.php
